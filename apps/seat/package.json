{
  "name": "@saakshi/seat",
  "version": "0.0.1",
  "private": true,
  "description": "Saakshi exam seat",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "copy-mediapipe": "node scripts/copy-mediapipe.mjs",
    "dev": "pnpm copy-mediapipe && electron-vite dev",
    "build": "pnpm copy-mediapipe && electron-vite build",
    "pack:mac": "pnpm build && electron-builder --mac --dir && sh scripts/adhoc-sign.sh",
    "pack:win": "pnpm build && electron-builder --win --dir",
    "pack:e2e": "SAAKSHI_E2E=1 pnpm build && electron-builder --dir -c electron-builder.e2e.yml && (test \"$(uname)\" != Darwin || sh scripts/adhoc-sign.sh release-e2e)",
    "pack:e2e:win": "set SAAKSHI_E2E=1&& pnpm build && electron-builder --win --dir -c electron-builder.e2e.yml",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@saakshi/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
